<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>idinstance</name>
        <type>integer</type>
    </column>
    <column>
        <name>moodle_roleid</name>
        <type>integer</type>
    </column>
    <column>
        <name>moodle_role_shortname</name>
        <type>varchar(100)</type>
    </column>
    <column>
        <name>description</name>
        <type>varchar(200)</type>
    </column>
    <column>
        <name>is_default</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>context_level</name>
        <type>varchar(20)</type>
    </column>
    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>
    <constraint>
        <name>moodle_role_map_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>moodle_role_map_instance_role</name>
        <type>UNIQUE (idinstance, moodle_roleid)</type>
    </constraint>
    <constraint>
        <name>ca_moodle_role_map_instances</name>
        <type>FOREIGN KEY (idinstance) REFERENCES moodle_instances (id) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
</table>
