<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
    </column>
    <column>
        <name>idcontacto</name>
        <type>integer</type>
    </column>
    <column>
        <name>idinstance</name>
        <type>integer</type>
    </column>
    <column>
        <name>moodle_userid</name>
        <type>integer</type>
    </column>
    <column>
        <name>moodle_username</name>
        <type>varchar(100)</type>
    </column>
    <column>
        <name>sync_direction</name>
        <type>varchar(20)</type>
    </column>
    <column>
        <name>last_sync</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>last_error</name>
        <type>text</type>
    </column>
    <column>
        <name>sync_priority</name>
        <type>varchar(20)</type>
    </column>
    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>
    <constraint>
        <name>moodle_user_map_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>moodle_user_map_instance_user</name>
        <type>UNIQUE (idinstance, moodle_userid)</type>
    </constraint>
    <constraint>
        <name>moodle_user_map_instance_contact</name>
        <type>UNIQUE (idinstance, idcontacto)</type>
    </constraint>
    <constraint>
        <name>ca_moodle_user_map_contactos</name>
        <type>FOREIGN KEY (idcontacto) REFERENCES contactos (idcontacto) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_moodle_user_map_instances</name>
        <type>FOREIGN KEY (idinstance) REFERENCES moodle_instances (id) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
</table>
