    <constraint>
        <name>moodle_certificates_fk_contacto</name>
        <type>FOREIGN KEY (idcontacto) REFERENCES contactos (idcontacto) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>moodle_certificates_fk_factura</name>
        <type>FOREIGN KEY (idfactura) REFERENCES facturascli (idfactura) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>moodle_certificates_unique</name>
        <type>UNIQUE (idinstance, moodle_userid, badge_id)</type>
    </constraint>
