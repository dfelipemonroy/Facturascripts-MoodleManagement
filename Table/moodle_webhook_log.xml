<?xml version="1.0" encoding="UTF-8"?>
<!--
    moodle_webhook_log — audit trail for every webhook call received
    from a Moodle instance (or bad caller trying to impersonate one).

    @since 2.0 — V2.0-ACTION-PLAN F10.1 · §6.14
-->
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>idinstance</name>
        <type>integer</type>
    </column>
    <column>
        <name>event_type</name>
        <type>character varying(60)</type>
    </column>
    <column>
        <name>received_at</name>
        <type>timestamp</type>
        <null>NO</null>
    </column>
    <column>
        <name>ip</name>
        <type>character varying(45)</type>
    </column>
    <column>
        <name>signature_ok</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>timestamp_ok</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>nonce_ok</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>outcome</name>
        <type>character varying(30)</type>
    </column>
    <column>
        <name>http_status</name>
        <type>integer</type>
    </column>
    <column>
        <name>payload_hash</name>
        <type>character varying(64)</type>
    </column>
    <column>
        <name>payload_bytes</name>
        <type>integer</type>
    </column>
    <column>
        <name>error_message</name>
        <type>character varying(500)</type>
    </column>
    <constraint>
        <name>moodle_webhook_log_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>ca_mm_whl_instance</name>
        <type>FOREIGN KEY (idinstance) REFERENCES moodle_instances (id) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
</table>
