# Ignore all internal docs by default...
# Using docs/* (not docs/) so that selective !docs/<file> exceptions work.
docs/*
# ...but keep the v2.0 plan, checklist and the dead-code audit
# note version-controlled.
!docs/V2.0-ACTION-PLAN.md
!docs/V2.0-TASK-CHECKLIST.md
!docs/DEAD-CODE-AUDIT.md
!docs/PHP-INI-HARDENING.md
!docs/SUPPORTED-VERSIONS.md
!docs/TROUBLESHOOTING.md
!docs/EVENTS.md
!docs/QA-SMOKE-TEST.md
!docs/QA-V1-REGRESSION.md
!docs/QA-PERFORMANCE.md
!docs/QA-OWASP-ZAP.md
!docs/RELEASE-CHECKLIST.md
!docs/QA-LINT-ANALYSE.md

vendor/
.phpunit.cache/

# PHP-CS-Fixer / PHPStan caches
.php-cs-fixer.cache

# PHPUnit coverage reports (produced locally, kept out of repo)
.phpunit.cache/coverage-html/
.phpunit.cache/coverage.xml
.phpunit.cache/junit.xml
.phpunit.cache/result

