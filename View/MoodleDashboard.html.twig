{% extends "Master/MenuBghTemplate.html.twig" %}

{% block bodyHeaderOptions %}
    {{ parent() }}
    {% set pageData = fsc.getPageData() %}
    <div class="container-fluid d-print-none">
        <div class="row">
            <div class="col-md d-none d-md-inline-block text-end">
                <i class="{{ pageData.icon }} fa-3x ps-3 float-end" aria-hidden="true"></i>
                <h1 class="h5 mb-0">{{ trans(pageData.title) }}</h1>
                <p class="text-muted mb-3">{{ trans('moodle-dashboard-subtitle') }}</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    {% set data = fsc.dashboardData %}
    {# F3.1 — Upgrade Chart.js 2.9 -> 4.x.
       Primary source: plugin-vendored UMD bundle shipped under
       Assets/JS/vendor/ so the dashboard does not depend on the
       host FS `node_modules/chart.js/` version (FS 2026 still
       ships Chart 2.x there).
       Fallback: jsDelivr CDN via a runtime check — if
       `window.Chart` stays undefined after the first script tag
       loaded, we inject the CDN copy. Air-gapped installs can
       delete the fallback line. #}
    <script src="{{ asset('Plugins/MoodleManagement/Assets/JS/vendor/chart.umd.js') }}"></script>
    <script>
        // eslint-disable-next-line no-unused-expressions
        if (typeof window.Chart === 'undefined') {
            var s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.js';
            s.defer = false;
            document.head.appendChild(s);
        }
    </script>
    {# Shared stylesheet (F1.8). A11y JS (F1.7). #}
    <link rel="stylesheet" href="{{ asset('Plugins/MoodleManagement/Assets/CSS/moodle.css') }}"/>
    <script src="{{ asset('Plugins/MoodleManagement/Assets/JS/a11y-enhance.js') }}"></script>

    <div class="container-fluid mt-3 mb-4">
        {# Summary cards row 1 #}
        <div class="row mb-4">
            <div class="col-xl col-md-4 col-6 mb-2">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3 text-center">
                        <h3 class="mb-0 text-primary">{{ data.totalEnrolments | default(0) }}</h3>
                        <small class="text-muted">{{ trans('total-enrolments') }}</small>
                    </div>
                </div>
            </div>
            <div class="col-xl col-md-4 col-6 mb-2">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3 text-center">
                        <h3 class="mb-0 text-success">{{ data.statusCounts.enrolled | default(0) }}</h3>
                        <small class="text-muted">{{ trans('enrolled') }}</small>
                    </div>
                </div>
            </div>
            <div class="col-xl col-md-4 col-6 mb-2">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3 text-center">
                        <h3 class="mb-0 text-warning">{{ data.statusCounts.pending | default(0) }}</h3>
                        <small class="text-muted">{{ trans('pending') }}</small>
                    </div>
                </div>
            </div>
            <div class="col-xl col-md-4 col-6 mb-2">
                <div class="card shadow-sm border-0 h-100 border-start border-danger border-3">
                    <div class="card-body py-3 text-center">
                        <h3 class="mb-0 text-danger">{{ data.unbilledCount | default(0) }}</h3>
                        <small class="text-muted">{{ trans('unbilled-enrolments') }}</small>
                    </div>
                </div>
            </div>
            <div class="col-xl col-md-4 col-6 mb-2">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3 text-center">
                        <h3 class="mb-0 mm-metric-purple">{{ data.activeInstances | default(0) }}</h3>
                        <small class="text-muted">{{ trans('active-instances') }}</small>
                    </div>
                </div>
            </div>
            <div class="col-xl col-md-4 col-6 mb-2">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3 text-center">
                        <h3 class="mb-0 mm-metric-cyan">{{ data.totalUsers | default(0) }}</h3>
                        <small class="text-muted">{{ trans('mapped-users') }}</small>
                    </div>
                </div>
            </div>
        </div>

        {# 6-chart grid: 2 rows x 3 cols. All cards col-lg-4 so the
           layout collapses cleanly to 2 cols (md) and 1 col (sm). #}

        {# Row 1: Status doughnut | Progress histogram | Methods pie #}
        <div class="row mb-4">
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pb-0">
                        <h6 class="mb-0"><i class="fa-solid fa-chart-pie me-1 text-muted"></i> {{ trans('enrolments-by-status') }}</h6>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        {# F3.12 — skeleton shown until Chart.js finishes rendering. #}
                        <span id="chartStatusSkeleton" class="mm-skeleton mm-skeleton--card" aria-hidden="true"></span>
                        <canvas id="chartStatus" class="d-none"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pb-0">
                        <h6 class="mb-0"><i class="fa-solid fa-bars-progress me-1 text-muted"></i> {{ trans('progress-distribution') }}</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="chartProgress" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pb-0">
                        <h6 class="mb-0"><i class="fa-solid fa-sliders me-1 text-muted"></i> {{ trans('enrolments-by-method') }}</h6>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <canvas id="chartMethods"></canvas>
                    </div>
                </div>
            </div>
        </div>

        {# Row 2: Monthly enrolments | Top courses | Certificates by month #}
        <div class="row mb-4">
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pb-0">
                        <h6 class="mb-0"><i class="fa-solid fa-chart-bar me-1 text-muted"></i> {{ trans('enrolments-by-month') }}</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="chartMonthly" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pb-0">
                        <h6 class="mb-0"><i class="fa-solid fa-graduation-cap me-1 text-muted"></i> {{ trans('top-courses') }}</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="chartTopCourses" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pb-0">
                        <h6 class="mb-0"><i class="fa-solid fa-certificate me-1 text-muted"></i> {{ trans('certificates-by-month') }}</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="chartCertMonthly" height="220"></canvas>
                    </div>
                </div>
            </div>
        </div>

        {# Quick links #}
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body py-2">
                        <a href="ListMoodleReport" class="btn btn-outline-primary btn-sm me-2">
                            <i class="fa-solid fa-chart-bar me-1"></i> {{ trans('moodle-reports') }}
                        </a>
                        <a href="ListMoodleEnrolment" class="btn btn-outline-secondary btn-sm me-2">
                            <i class="fa-solid fa-user-graduate me-1"></i> {{ trans('moodle-enrolments') }}
                        </a>
                        <a href="ListMoodleCourseMap" class="btn btn-outline-secondary btn-sm me-2">
                            <i class="fa-solid fa-book me-1"></i> {{ trans('moodle-courses') }}
                        </a>
                        <a href="ListMoodleUserMap" class="btn btn-outline-secondary btn-sm">
                            <i class="fa-solid fa-users me-1"></i> {{ trans('moodle-users') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Gradient helper ---
        function makeGradient(ctx, color1, color2) {
            var g = ctx.createLinearGradient(0, ctx.canvas.height, 0, 0);
            g.addColorStop(0, color1);
            g.addColorStop(1, color2);
            return g;
        }

        // Chart.js 4 style tokens shared across the 4 charts.
        // F3.1 — `legend` / `tooltips` moved under `plugins`; ticks.fontColor
        // renamed to ticks.color; gridLines renamed to grid; yAxes[]/xAxes[]
        // collapsed into `y` / `x`. horizontalBar type replaced by
        // indexAxis: 'y' on a bar chart.
        var v4TooltipStyle = {
            backgroundColor: 'rgba(0,0,0,0.8)',
            cornerRadius: 6,
            padding: 10
        };

        // F3.12 — swap skeleton for the canvas once we're about to draw.
        function revealChart(canvasId, skeletonId) {
            var sk = document.getElementById(skeletonId);
            var cv = document.getElementById(canvasId);
            if (sk) sk.classList.add('d-none');
            if (cv) cv.classList.remove('d-none');
        }

        // --- 1. Status doughnut ---
        revealChart('chartStatus', 'chartStatusSkeleton');
        var ctxStatus = document.getElementById('chartStatus').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: [
                    '{{ trans('enrolled') }}',
                    '{{ trans('pending') }}',
                    '{{ trans('suspended') }}',
                    '{{ trans('unenrolled') }}'
                ],
                datasets: [{
                    data: [
                        {{ data.statusCounts.enrolled | default(0) }},
                        {{ data.statusCounts.pending | default(0) }},
                        {{ data.statusCounts.suspended | default(0) }},
                        {{ data.statusCounts.unenrolled | default(0) }}
                    ],
                    backgroundColor: ['#198754', '#ffc107', '#adb5bd', '#dc3545'],
                    borderWidth: 0,
                    hoverBorderWidth: 2,
                    hoverBorderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                cutout: '65%',
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 15, usePointStyle: true } },
                    tooltip: v4TooltipStyle
                }
            }
        });

        // --- 2. Monthly bar with gradient ---
        var ctxMonthly = document.getElementById('chartMonthly').getContext('2d');
        var gradBlue = makeGradient(ctxMonthly, 'rgba(13,110,253,0.10)', '#0d6efd');
        new Chart(ctxMonthly, {
            type: 'bar',
            data: {
                labels: {{ data.monthLabelsJson | default('[]') | raw }},
                datasets: [{
                    label: '{{ trans('moodle-enrolments') }}',
                    data: {{ data.monthDataJson | default('[]') | raw }},
                    backgroundColor: gradBlue,
                    borderColor: '#0d6efd',
                    borderWidth: 2,
                    borderSkipped: 'bottom',
                    barPercentage: 0.5,
                    categoryPercentage: 0.6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0, color: '#6c757d' },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: {
                        ticks: { color: '#6c757d' },
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: v4TooltipStyle
                }
            }
        });

        // --- 3. Top courses horizontal bar with individual gradients ---
        // Chart.js 4 removed `type: 'horizontalBar'`; use bar with indexAxis: 'y'.
        var ctxCourses = document.getElementById('chartTopCourses').getContext('2d');
        var courseColors = [
            { base: '#0d6efd', light: 'rgba(13,110,253,0.15)' },
            { base: '#6f42c1', light: 'rgba(111,66,193,0.15)' },
            { base: '#0dcaf0', light: 'rgba(13,202,240,0.15)' },
            { base: '#fd7e14', light: 'rgba(253,126,20,0.15)' },
            { base: '#20c997', light: 'rgba(32,201,151,0.15)' }
        ];
        var courseData = {{ data.topCourseDataJson | default('[]') | raw }};
        var courseBg = courseData.map(function(v, i) {
            var c = courseColors[i % courseColors.length];
            var g = ctxCourses.createLinearGradient(0, 0, ctxCourses.canvas.width, 0);
            g.addColorStop(0, c.light);
            g.addColorStop(1, c.base);
            return g;
        });
        var courseBorder = courseData.map(function(v, i) {
            return courseColors[i % courseColors.length].base;
        });
        new Chart(ctxCourses, {
            type: 'bar',
            data: {
                labels: {{ data.topCourseLabelsJson | default('[]') | raw }},
                datasets: [{
                    data: courseData,
                    backgroundColor: courseBg,
                    borderColor: courseBorder,
                    borderWidth: 2,
                    barPercentage: 0.4,
                    categoryPercentage: 0.5
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: { precision: 0, color: '#6c757d' },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    y: {
                        ticks: { color: '#6c757d' },
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: v4TooltipStyle
                }
            }
        });

        // --- 4. Methods pie ---
        var ctxMethods = document.getElementById('chartMethods').getContext('2d');
        var methodPalette = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#0dcaf0', '#fd7e14'];
        new Chart(ctxMethods, {
            type: 'pie',
            data: {
                labels: {{ data.methodLabelsJson | default('[]') | raw }},
                datasets: [{
                    data: {{ data.methodDataJson | default('[]') | raw }},
                    backgroundColor: methodPalette.slice(0, {{ data.methodLabels | default([]) | length }}),
                    borderWidth: 0,
                    hoverBorderWidth: 2,
                    hoverBorderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 15, usePointStyle: true } },
                    tooltip: v4TooltipStyle
                }
            }
        });

        // --- 5. Progress distribution (histogram) ---
        // Colour-coded bars so operators can spot "stuck at 0%" at a
        // glance: red for 0%, yellow for the middle buckets, green
        // for 100%.
        var ctxProgress = document.getElementById('chartProgress').getContext('2d');
        var progressColors = ['#dc3545', '#fd7e14', '#ffc107', '#0dcaf0', '#0d6efd', '#198754'];
        new Chart(ctxProgress, {
            type: 'bar',
            data: {
                labels: {{ data.progressLabelsJson | default('[]') | raw }},
                datasets: [{
                    label: '{{ trans('enrolments') }}',
                    data: {{ data.progressDataJson | default('[]') | raw }},
                    backgroundColor: progressColors,
                    borderWidth: 0,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: v4TooltipStyle
                }
            }
        });

        // --- 6. Certificates issued per month (line) ---
        var ctxCertMonthly = document.getElementById('chartCertMonthly').getContext('2d');
        new Chart(ctxCertMonthly, {
            type: 'line',
            data: {
                labels: {{ data.certMonthLabelsJson | default('[]') | raw }},
                datasets: [{
                    label: '{{ trans('certificates') }}',
                    data: {{ data.certMonthDataJson | default('[]') | raw }},
                    borderColor: '#6f42c1',
                    backgroundColor: 'rgba(111,66,193,0.10)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#6f42c1',
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: v4TooltipStyle
                }
            }
        });
    });
    </script>
{% endblock %}
