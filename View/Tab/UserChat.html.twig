{# UserChat tab — WhatsApp-style chat UI for FS↔Moodle messaging.
   Styles moved from inline to Assets/CSS/moodle.css (F1.8). #}
<link rel="stylesheet" href="{{ asset('Plugins/MoodleManagement/Assets/CSS/moodle.css') }}"/>

{% set model = fsc.getModel() %}
{% set messages = fsc.chatMessages %}
{% set error = fsc.chatError %}
{% set serviceUserId = fsc.chatServiceUserId %}
{% set serviceUserName = fsc.chatServiceUserName %}
{% set conversationId = fsc.chatConversationId %}
{% set contactName = fsc.chatContactName | default(model.moodle_username | default('User #' ~ model.moodle_userid)) %}

<div class="container-fluid mt-3 mb-3">
    {% if error is not empty %}
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            {{ error }}
        </div>
    {% elseif model.moodle_userid is empty %}
        <div class="alert alert-info">
            <i class="fa-solid fa-info-circle me-1"></i>
            {{ trans('moodle-userid-required') }}
        </div>
    {% else %}
        {# Chat container #}
        <div class="card">
            <div class="card-header bg-primary text-white d-flex align-items-center">
                <i class="fa-solid fa-comments me-2"></i>
                <strong>{{ trans('chat-with') }} {{ model.moodle_username | default('User #' ~ model.moodle_userid) }}</strong>
                <small class="ms-auto opacity-75">
                    <i class="fa-solid fa-shield-halved me-1"></i>{{ serviceUserName }}
                    <span id="chatRefreshIndicator" class="ms-2 d-none">
                        <i class="fa-solid fa-sync fa-spin"></i>
                    </span>
                </small>
            </div>

            {# Messages area #}
            <div id="chatMessagesArea" class="card-body p-3 mm-chat-area">
                {% if messages is empty %}
                    <div id="chatEmptyState" class="text-center text-muted py-5">
                        <i class="fa-regular fa-comments fa-3x mb-3 d-block opacity-50"></i>
                        {{ trans('no-messages-yet') }}
                    </div>
                {% else %}
                    {% for msg in messages %}
                        {% set isMe = (msg.useridfrom == serviceUserId) %}
                        <div class="d-flex mb-2 {{ isMe ? 'justify-content-end' : 'justify-content-start' }}">
                            <div class="mm-chat-bubble {{ isMe ? 'mm-chat-bubble--me' : 'mm-chat-bubble--other' }}">
                                {% if not isMe %}
                                    <div class="mm-chat-sender">
                                        {{ contactName }}
                                    </div>
                                {% endif %}
                                {# F2.1 — stored XSS fix: escape then convert \n to <br>.
                                   `nl2br` in Twig is safe by design: it escapes HTML
                                   first and only injects <br> tags. Never use |raw here. #}
                                <div class="mm-chat-text">{{ msg.text | nl2br }}</div>
                                <div class="mm-chat-meta">
                                    {{ msg.timecreated | date('d/m/Y H:i') }}
                                    {% if isMe %}
                                        <i class="fa-solid fa-check-double ms-1 mm-chat-read"></i>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {# Input area #}
            <div class="card-footer p-2 mm-chat-footer">
                <form id="chatForm" method="post" class="d-flex gap-2 align-items-end">
                    <input type="hidden" name="action" value="send-chat-message"/>
                    <input type="hidden" name="code" value="{{ model.primaryColumnValue() }}"/>
                    <input type="hidden" name="multireqtoken" value="{{ fsc.multiRequestProtection.newToken() }}"/>
                    <input type="hidden" name="activetab" value="UserChat"/>
                    <div class="flex-grow-1">
                        {# F3.2 — Enter-submit handled by mm-actions.js via data-mm-enter-submit #}
                        <textarea id="chatInput" name="chat_message" class="form-control mm-chat-textarea" rows="1" placeholder="{{ trans('type-your-message') }}" required
                                  data-mm-enter-submit="1"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-circle mm-chat-send-btn" title="{{ trans('send-message') }}">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>

        <small class="text-muted mt-2 d-block">
            <i class="fa-solid fa-circle-info me-1"></i>
            {{ trans('chat-info-note') }}
        </small>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var area = document.getElementById('chatMessagesArea');
    if (!area) return;

    // Scroll to bottom on load
    area.scrollTop = area.scrollHeight;

    // Auto-refresh config
    var code = '{{ model.primaryColumnValue() }}';
    var serviceUserId = {{ serviceUserId | default(0) }};
    var contactName = '{{ contactName | e('js') }}';
    var lastMessageCount = {{ messages | length }};
    // F3.3 — polling with exponential backoff.
    // - Baseline 5 s between successful fetches.
    // - On failure (network error or non-2xx), the delay doubles up
    //   to 5 min so a prolonged backend outage does not drown the
    //   server with retries.
    // - Resets to baseline on the next successful response.
    var refreshBaseMs = 5000;
    var refreshMaxMs = 300000;
    var refreshDelay = refreshBaseMs;
    var refreshTimer = null;

    function formatDate(timestamp) {
        var d = new Date(timestamp * 1000);
        var pad = function(n) { return n < 10 ? '0' + n : n; };
        return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Convert \n to <br>. The input is ALREADY entity-escaped by
    // escapeHtml() at the call site, so adding <br> is safe.
    function nl2br(safeHtml) {
        return safeHtml.replace(/\r?\n/g, '<br>');
    }

    function renderMessage(msg) {
        var isMe = (parseInt(msg.useridfrom) === serviceUserId);
        var bubbleClass = 'mm-chat-bubble ' + (isMe ? 'mm-chat-bubble--me' : 'mm-chat-bubble--other');
        var bubble = '<div class="d-flex mb-2 ' + (isMe ? 'justify-content-end' : 'justify-content-start') + '">';
        bubble += '<div class="' + bubbleClass + '">';
        if (!isMe) {
            bubble += '<div class="mm-chat-sender">' + escapeHtml(contactName) + '</div>';
        }
        // F2.2 — stored XSS fix: escape msg.text before injecting,
        // then convert \n to <br> (safe because input already escaped).
        bubble += '<div class="mm-chat-text">' + nl2br(escapeHtml(msg.text || '')) + '</div>';
        bubble += '<div class="mm-chat-meta">';
        bubble += escapeHtml(formatDate(msg.timecreated));
        if (isMe) {
            bubble += ' <i class="fa-solid fa-check-double ms-1 mm-chat-read"></i>';
        }
        bubble += '</div></div></div>';
        return bubble;
    }

    function refreshChat() {
        var indicator = document.getElementById('chatRefreshIndicator');
        if (indicator) indicator.classList.remove('d-none');

        return fetch('EditMoodleUserMap?code=' + encodeURIComponent(code) + '&action=load-chat-messages', {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(response) {
            if (!response.ok) {
                throw new Error('http_' + response.status);
            }
            return response.json();
        })
        .then(function(data) {
            if (indicator) indicator.classList.add('d-none');
            refreshDelay = refreshBaseMs;   // F3.3 — reset on success.

            if (data.error || !data.messages) return;

            if (data.contactName) contactName = data.contactName;

            // Only update if message count changed
            if (data.messages.length === lastMessageCount) return;

            lastMessageCount = data.messages.length;

            // Check if user is scrolled near bottom (within 100px)
            var wasAtBottom = (area.scrollHeight - area.scrollTop - area.clientHeight) < 100;

            // Remove empty state if present
            var emptyState = document.getElementById('chatEmptyState');
            if (emptyState) emptyState.remove();

            // Re-render all messages
            var html = '';
            for (var i = 0; i < data.messages.length; i++) {
                html += renderMessage(data.messages[i]);
            }
            area.innerHTML = html;

            // Scroll to bottom if user was already at bottom
            if (wasAtBottom) {
                area.scrollTop = area.scrollHeight;
            }
        })
        .catch(function(err) {
            if (indicator) indicator.classList.add('d-none');
            // F3.3 — double the wait on failure; cap at refreshMaxMs.
            refreshDelay = Math.min(refreshDelay * 2, refreshMaxMs);
            // FE-06 (2026-04-17) — previously the catch swallowed 5xx
            // without surfacing anything to operators. Log the error
            // and set an aria-live status line so a sustained outage
            // is at least visible in the page.
            if (window.console && console.warn) {
                console.warn('mm-chat-refresh-failed', err);
            }
            var status = document.getElementById('mm-chat-status');
            if (status) {
                status.textContent = '{{ trans("chat-refresh-failed") | e("js") }}';
            }
        });
    }

    // F3.3 — Start auto-refresh with exponential backoff.
    // Uses a self-rescheduling setTimeout so the next invocation only
    // happens after the current one has resolved, giving the backoff
    // logic a chance to adjust the next delay.
    function scheduleNext() {
        refreshTimer = setTimeout(function () {
            refreshChat().finally(scheduleNext);
        }, refreshDelay);
    }

    function startRefresh() {
        if (!refreshTimer) {
            scheduleNext();
        }
    }

    function stopRefresh() {
        if (refreshTimer) {
            clearTimeout(refreshTimer);
            refreshTimer = null;
        }
    }

    // Start immediately
    startRefresh();

    // Stop when tab is hidden, restart when visible
    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            stopRefresh();
        } else {
            startRefresh();
        }
    });
});
</script>
