<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="name" numcolumns="3" order="100">
            <widget type="text" fieldname="name"/>
        </column>
        <column name="moodle-instance" order="110">
            <widget type="select" fieldname="idinstance" required="true">
                <values source="moodle_instances" fieldcode="id" fieldtitle="name"/>
            </widget>
        </column>
        <column name="family" order="120">
            <widget type="select" fieldname="codfamilia">
                <values source="familias" fieldcode="codfamilia" fieldtitle="descripcion"/>
            </widget>
        </column>
        <column name="moodle-category-id" display="right" order="125">
            <widget type="number" fieldname="moodle_categoryid" decimal="0"/>
        </column>
        <column name="parent-category" order="127">
            <widget type="select" fieldname="parent_categoryid">
                <values source="MoodleCourseCategory" fieldcode="moodle_categoryid" fieldtitle="name"/>
            </widget>
        </column>
        <column name="visible" display="center" order="130">
            <widget type="checkbox" fieldname="visible"/>
        </column>
        <column name="sync-active" display="center" order="135">
            <widget type="checkbox" fieldname="sync_active"/>
        </column>
        <column name="source" order="140">
            <widget type="select" fieldname="source" translate="true">
                <values title="fs_managed">fs_managed</values>
                <values title="moodle_managed">moodle_managed</values>
                <values title="synced">synced</values>
            </widget>
        </column>
        <column name="last-sync" order="150">
            <widget type="datetime" fieldname="last_sync"/>
        </column>
    </columns>
    <modals>
        <group name="import-categories-from-moodle" title="import-categories-from-moodle" icon="fa-solid fa-download">
            <column name="moodle-instance" numcolumns="12" description="select-moodle-instance-import">
                <widget type="select" fieldname="idinstance" required="true">
                    <values source="moodle_instances" fieldcode="id" fieldtitle="name"/>
                </widget>
            </column>
        </group>
    </modals>
</view>
