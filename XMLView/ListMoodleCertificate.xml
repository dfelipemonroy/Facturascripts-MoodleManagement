<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="id" display="none" order="100">
            <widget type="text" fieldname="id"/>
        </column>
        <column name="badge-name" order="110">
            <widget type="text" fieldname="badge_name" onclick="EditMoodleCertificate"/>
        </column>
        <column name="contact" order="120">
            <widget type="autocomplete" fieldname="idcontacto" onclick="EditContacto">
                <values source="contactos" fieldcode="idcontacto" fieldtitle="descripcion"/>
            </widget>
        </column>
        <column name="course" order="130">
            <widget type="text" fieldname="course_name"/>
        </column>
        <column name="date-issued" order="140">
            <widget type="datetime" fieldname="date_issued"/>
        </column>
        <column name="date-expire" order="150">
            <widget type="datetime" fieldname="date_expire"/>
        </column>
        <column name="unique-hash" display="none" order="160">
            <widget type="text" fieldname="unique_hash"/>
        </column>
        <column name="moodle-instance" display="none" order="170">
            <widget type="select" fieldname="idinstance" onclick="EditMoodleInstance">
                <values source="moodle_instances" fieldcode="id" fieldtitle="name"/>
            </widget>
        </column>
        <column name="last-sync" display="none" order="180">
            <widget type="datetime" fieldname="last_sync"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="success" fieldname="date_expire"></option>
        </row>
        <row type="actions">
            <button type="action" label="sync-all-badges" action="sync-all-badges" icon="fa-solid fa-arrows-rotate" color="warning" confirm="true"/>
        </row>
    </rows>
</view>
