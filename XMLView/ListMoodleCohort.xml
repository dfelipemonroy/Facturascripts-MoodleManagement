<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="name" order="100">
            <widget type="text" fieldname="name"/>
        </column>
        <column name="moodle-instance" order="110">
            <widget type="select" fieldname="idinstance">
                <values source="moodle_instances" fieldcode="id" fieldtitle="name"/>
            </widget>
        </column>
        <column name="idnumber" order="120">
            <widget type="text" fieldname="idnumber"/>
        </column>
        <column name="source" order="130">
            <widget type="select" fieldname="source" translate="true">
                <values title="fs-managed">fs_managed</values>
                <values title="moodle-managed">moodle_managed</values>
                <values title="synced">synced</values>
            </widget>
        </column>
        <column name="member-count" order="140">
            <widget type="number" fieldname="member_count"/>
        </column>
        <column name="customer-group" display="none" order="145">
            <widget type="select" fieldname="codgrupo">
                <values source="gruposclientes" fieldcode="codgrupo" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="last-sync" order="150">
            <widget type="datetime" fieldname="last_sync"/>
        </column>
    </columns>
</view>
