<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="name" numcolumns="3" order="100">
            <widget type="text" fieldname="name"/>
        </column>
        <column name="moodle-instance" order="110">
            <widget type="select" fieldname="idinstance">
                <values source="moodle_instances" fieldcode="id" fieldtitle="name"/>
            </widget>
        </column>
        <column name="cohort-idnumber" order="120">
            <widget type="text" fieldname="idnumber"/>
        </column>
        <column name="source" order="130">
            <widget type="select" fieldname="source" translate="true">
                <values title="fs_managed">fs_managed</values>
                <values title="moodle_managed">moodle_managed</values>
                <values title="synced">synced</values>
            </widget>
        </column>
        <column name="member-count" display="right" order="140">
            <widget type="number" fieldname="member_count" decimal="0"/>
        </column>
        <column name="sync-active" display="center" order="145">
            <widget type="checkbox" fieldname="sync_active"/>
        </column>
        <column name="customer-group" display="none" order="147">
            <widget type="select" fieldname="codgrupo">
                <values source="gruposclientes" fieldcode="codgrupo" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="last-sync" order="150">
            <widget type="datetime" fieldname="last_sync"/>
        </column>
    </columns>
    <modals>
        <group name="import-cohorts-from-moodle" title="import-cohorts-from-moodle" icon="fa-solid fa-download">
            <column name="moodle-instance" numcolumns="12" description="select-moodle-instance-import-cohorts">
                <widget type="select" fieldname="idinstance" required="true">
                    <values source="moodle_instances" fieldcode="id" fieldtitle="name"/>
                </widget>
            </column>
        </group>
    </modals>
</view>
